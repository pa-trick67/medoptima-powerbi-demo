expression fx_loadData = ```
		let
		    Source = (itemName as text, optional isKindTable as logical) as table =>
		    [
		        ClasseurLoc = Excel.Workbook(
		            File.Contents(CheminFichier),
		            null,
		            true
		        ),
		        ClasseurLig = Excel.Workbook(Web.Contents("https://docs.google.com/spreadsheets/d/e/2PACX-1vSrfKPQTEAxS44vW3EU8LRdFM-puD5tRmtzK9GUwy2aT78hE7LGWpwmbe6TieAR2w/pub?output=xlsx"), null, true),      
		        Kind = if isKindTable = null then "Table" else "Sheet",
		        Classeur_mode = if Mode = "Ligne" then ClasseurLig else ClasseurLoc,
		        Nav = Classeur_mode{[Item = itemName, Kind = Kind]}[Data]
		    ][Nav]
		in
		    Source
		```
	lineageTag: 478259e4-8c92-46ce-adc1-756bc2aed40d

	annotation PBI_ResultType = Function

expression CheminFichier = "D:\03 - Work\KAJY Partners\Conférence Excel BI\MedOptima\MedOptima_Distribution_Donnees.xlsx" meta [IsParameterQuery = true, IsParameterQueryRequired = true, Type = type text]
