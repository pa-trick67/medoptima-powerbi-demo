/// Le fichier excel source est en local ou en ligNE
expression Mode =
		let
		    Source = "Ligne" meta [IsParameterQuery = true, IsParameterQueryRequired = true, Type = type text, List = {"Local", "Ligne"}, DefaultValue = "Ligne"]
		in
		    Source
