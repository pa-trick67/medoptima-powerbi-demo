	/// Carte KPI du taux d'atteinte de l'objectif (fonction fx_kpi_card_pct).
	measure 'KPI Taux d''atteinte' = fx_kpi_card_pct( "Taux d’atteinte objectif", [Taux atteinte %], FALSE() )
		displayFolder: 05 Visuels
		lineageTag: fdc969cb-f080-4532-934e-9185630a1590
		dataCategory: ImageUrl

	/// Région avec le plus fort CA HT dans la sélection (segments et filtres respectés). En cas d'égalité, les régions sont listées.
	measure 'Top 1 Région (CA)' =
			
			VAR _Top =
			    TOPN( 1,
			        FILTER( ALLSELECTED( Dim_Region[Region] ), [CA HT] > 0 ),
			        [CA HT], DESC )
			RETURN
			    CONCATENATEX( _Top, Dim_Region[Region], ", ", Dim_Region[Region], ASC )
		displayFolder: 01 Ventes
		lineageTag: 583aa593-53a5-451a-9375-a6b815acc7ef

	/// Commercial avec le meilleur taux d'atteinte d'objectif dans la sélection (segments et filtres respectés). En cas d'égalité, les commerciaux sont listés.
	measure 'Top 1 Commercial (atteinte)' =
			
			VAR _Top =
			    TOPN( 1,
			        FILTER( ALLSELECTED( Dim_Commercial[Nom_Commercial] ), NOT ISBLANK( [Taux atteinte %] ) ),
			        [Taux atteinte %], DESC )
			RETURN
			    CONCATENATEX( _Top, Dim_Commercial[Nom_Commercial], ", ", Dim_Commercial[Nom_Commercial], ASC )
		displayFolder: 03 Objectifs
		lineageTag: ff6e9af0-9fab-497b-b36f-fb4d1f5c09a3

	/// Texte de l'année sélectionnée : « Toutes les années » si aucun filtre, la liste si 2-3 années, sinon le nombre d'années.
	measure 'Année sélectionnée' =
			
			VAR _Sel = VALUES( 'Dim_Date'[Année] )
			VAR _Nb  = COUNTROWS( _Sel )
			RETURN
			    SWITCH( TRUE(),
			        _Nb = COUNTROWS( ALL( 'Dim_Date'[Année] ) ), "Toutes les années",
			        _Nb <= 3, CONCATENATEX( _Sel, FORMAT( 'Dim_Date'[Année], "0" ), ", ", 'Dim_Date'[Année], ASC ),
			        _Nb & " années" )
		displayFolder: 06 Sélection

	/// Texte de la région sélectionnée (tient aussi compte du commercial sélectionné : affiche sa région). « Toutes les régions » si aucun filtre, la liste si 2-3 régions.
	measure 'Région sélectionnée' =
			
			VAR _Sel = CALCULATETABLE( VALUES( Dim_Region[Region] ), Dim_Commercial )   -- région(s) des commerciaux visibles
			VAR _Nb  = COUNTROWS( _Sel )
			RETURN
			    SWITCH( TRUE(),
			        _Nb = COUNTROWS( ALL( Dim_Region[Region] ) ), "Toutes les régions",
			        _Nb <= 3, CONCATENATEX( _Sel, Dim_Region[Region], ", ", Dim_Region[Region], ASC ),
			        _Nb & " régions" )
		displayFolder: 06 Sélection

	/// Texte du commercial sélectionné : « Tous les commerciaux » si aucun filtre, la liste si 2-3 commerciaux, sinon le nombre de commerciaux (ex. « 4 commerciaux » quand une région est filtrée).
	measure 'Commercial sélectionné' =
			
			VAR _Sel = VALUES( Dim_Commercial[Nom_Commercial] )
			VAR _Nb  = COUNTROWS( _Sel )
			RETURN
			    SWITCH( TRUE(),
			        _Nb = COUNTROWS( ALL( Dim_Commercial[Nom_Commercial] ) ), "Tous les commerciaux",
			        _Nb <= 3, CONCATENATEX( _Sel, Dim_Commercial[Nom_Commercial], ", ", Dim_Commercial[Nom_Commercial], ASC ),
			        _Nb & " commerciaux" )
		displayFolder: 06 Sélection

