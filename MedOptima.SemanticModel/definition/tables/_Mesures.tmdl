	/// CA HT de l'année précédente, limité aux mois où le CA de la période courante est > 0 (comparaison à période égale).
	measure 'CA HT N-1' =
			
			VAR _MoisActifs = FILTER( VALUES( 'Dim_Date'[AnnéeMoisNum] ), [CA HT] > 0 )   -- mois de N avec du CA
			VAR _Dates = CALCULATETABLE( VALUES( 'Dim_Date'[Date] ), _MoisActifs )
			RETURN
			    CALCULATE( [CA HT], SAMEPERIODLASTYEAR( _Dates ) )
		formatString: #,0 \€
		displayFolder: 02 Temps
		lineageTag: b3007fc4-501f-4d7a-84ce-51aaa103cd7a

	measure 'Écart CA vs N-1' = [CA HT] - [CA HT N-1]
		formatString: #,0 \€
		displayFolder: 02 Temps
		lineageTag: bb8e2186-949d-4237-bbce-3948283cdb76

	measure 'Écart % CA vs N-1' = DIVIDE( [Écart CA vs N-1], [CA HT N-1] )
		formatString: 0.0 %
		displayFolder: 02 Temps
		lineageTag: edae2b92-b671-4946-8542-9bd47791da64

	measure 'CA HT YTD' = CALCULATE( [CA HT], DATESYTD( 'Dim_Date'[Date] ) )
		formatString: #,0 \€
		displayFolder: 02 Temps
		lineageTag: 7fda6033-800b-4423-8b19-41e26977e421

	/// Cumul annuel N-1, limité aux mois où le CA de N est > 0 (s'appuie sur [CA HT N-1]).
	measure 'CA HT YTD N-1' = CALCULATE( [CA HT N-1], DATESYTD( 'Dim_Date'[Date] ) )
		formatString: #,0 \€
		displayFolder: 02 Temps
		lineageTag: 17f1f36b-3553-4944-9150-a48b9ce90ce8

	measure 'Écart % YTD vs N-1' = DIVIDE( [CA HT YTD] - [CA HT YTD N-1], [CA HT YTD N-1] )
		formatString: 0.0 %
		displayFolder: 02 Temps
		lineageTag: 1d13e705-56bb-49d0-bf78-eaee436279cb

	measure 'CA HT M-1' = CALCULATE( [CA HT], DATEADD( 'Dim_Date'[Date], -1, MONTH ) )
		formatString: #,0 \€
		displayFolder: 02 Temps
		lineageTag: 56e388ca-7e3c-45fd-af0a-17ffc9499a59

	measure 'CA HT 12 mois glissants' = CALCULATE( [CA HT], DATESINPERIOD( 'Dim_Date'[Date], MAX( 'Dim_Date'[Date] ), -12, MONTH ) )
		formatString: #,0 \€
		displayFolder: 02 Temps
		lineageTag: f7074391-a754-4dcf-8c01-05cfa689bd12

	measure 'Marge HT YTD' = CALCULATE( [Marge HT], DATESYTD( 'Dim_Date'[Date] ) )
		formatString: #,0 \€
		displayFolder: 02 Temps
		lineageTag: 778b24aa-2e0b-44d9-bf4b-896d55044541

	/// Objectif de CA, limité aux mois où des ventes existent (jusqu'au mois de la dernière vente) pour comparer à période égale.
	measure Objectif =
			
			VAR _DerniereVente = CALCULATE( MAX( Fait_Ventes[Date] ), REMOVEFILTERS() )   -- dernière date de vente du modèle
			RETURN
			    CALCULATE(
			        SUM( Fait_Objectifs[Objectif] ),
			        KEEPFILTERS( 'Dim_Date'[Date] <= EOMONTH( _DerniereVente, 0 ) )
			    )
		formatString: #,0 \€
		displayFolder: 03 Objectifs
		lineageTag: 60900740-aee0-42eb-a387-a877a24c1649

	measure 'Objectif YTD' = CALCULATE( [Objectif], DATESYTD( 'Dim_Date'[Date] ) )
		formatString: #,0 \€
		displayFolder: 03 Objectifs
		lineageTag: 4394b4ef-817a-4a16-8d22-86375de5a0dd

	measure 'Écart vs objectif' = [CA HT] - [Objectif]
		formatString: #,0 \€
		displayFolder: 03 Objectifs
		lineageTag: 318ab28d-141d-4655-acb1-efd1d2b4095e

	measure 'Taux atteinte %' = DIVIDE( [CA HT], [Objectif] )
		formatString: 0.0 %
		displayFolder: 03 Objectifs
		lineageTag: d216bc76-0472-42c6-91a8-632f1fcc66ac

	measure 'Taux atteinte YTD %' = DIVIDE( [CA HT YTD], [Objectif YTD] )
		formatString: 0.0 %
		displayFolder: 03 Objectifs
		lineageTag: 44b7369b-f197-4055-9ee7-462b70f247e4

	measure 'Statut objectif' =
			SWITCH(
				TRUE(),
				ISBLANK( [Objectif] ), "Sans objectif",
				[Taux atteinte %] >= 1, "Atteint",
				[Taux atteinte %] >= 0.9, "Proche",
				"Non atteint"
			)
		displayFolder: 03 Objectifs
		lineageTag: aefb2f09-68a4-4d90-b384-7b3e56414e3f

	measure 'Stock unités' = CALCULATE( SUM( Fait_Stocks[Stock_Unites] ), LASTNONBLANK( 'Dim_Date'[Date], CALCULATE( COUNTROWS( Fait_Stocks ) ) ) )
		formatString: #,0
		displayFolder: 04 Stocks
		lineageTag: b275545e-df6a-41f2-bcbc-a28ee5225fe8

	measure 'Valeur stock HT' = CALCULATE( SUM( Fait_Stocks[Valeur_Stock_HT] ), LASTNONBLANK( 'Dim_Date'[Date], CALCULATE( COUNTROWS( Fait_Stocks ) ) ) )
		formatString: #,0 \€
		displayFolder: 04 Stocks
		lineageTag: b0ccb470-bf2f-418a-963b-72acd82ddad3

	measure 'Date du stock' = MAX( Fait_Stocks[Date_Stock] )
		formatString: dd/mm/yyyy
		displayFolder: 04 Stocks
		lineageTag: b32dfd1e-88f8-4224-819d-9b5eb9002746

	measure 'Nb jours écoulés' = CALCULATE( COUNTROWS( 'Dim_Date' ), 'Dim_Date'[EstPassé] = TRUE() )
		formatString: #,0
		displayFolder: 04 Stocks
		lineageTag: 3fa392e6-70ec-4911-a715-99f0e71ebba0

	measure 'Ventes moyennes par jour' = DIVIDE( [Quantité vendue], [Nb jours écoulés] )
		formatString: #,0.0
		displayFolder: 04 Stocks
		lineageTag: 4e626944-efc8-4ab4-8712-508817c6db4f

	measure 'Couverture stock (jours)' = DIVIDE( [Stock unités], [Ventes moyennes par jour] )
		formatString: #,0
		displayFolder: 04 Stocks
		lineageTag: 23e8d4d9-432e-4337-8daa-9935afc4cec1

