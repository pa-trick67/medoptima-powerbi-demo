	column JourSemaine = FORMAT( 'Dim_Date'[Date], "dddd" )
		dataType: string
		lineageTag: e1c0e50f-1e62-4db1-bf75-e15d88fe48be
		summarizeBy: none
		sortByColumn: NumJourSemaine

		annotation SummarizationSetBy = Automatic

	column EstPassé = 'Dim_Date'[Date] <= TODAY()
		dataType: boolean
		lineageTag: 2bb41c07-4f13-433f-a152-e2536a182ab0
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition Dim_Date = calculated
		mode: import
		source =
				VAR _MinVentes = MIN( Fait_Ventes[Date] )
				VAR _MinStocks = MIN( Fait_Stocks[Date_Stock] )
				VAR _MaxVentes = MAX( Fait_Ventes[Date] )
				VAR _MaxStocks = MAX( Fait_Stocks[Date_Stock] )
				VAR _Min = MINX( { _MinVentes, _MinStocks }, [Value] )
				VAR _Max = MAXX( { _MaxVentes, _MaxStocks }, [Value] )
				VAR _Debut = IF( ISBLANK( _Min ), DATE( YEAR( TODAY() ), 1, 1 ), DATE( YEAR( _Min ), 1, 1 ) )
				VAR _Fin = IF( ISBLANK( _Max ), DATE( YEAR( TODAY() ), 12, 31 ), DATE( YEAR( _Max ), 12, 31 ) )
				RETURN
					CALENDAR( _Debut, _Fin )

