	column AnnéeMois = FORMAT( 'Dim_Date'[Date], "yyyy-mm" )
		dataType: string
		lineageTag: 1d0f84f5-86f2-49a2-844b-fec142514271
		summarizeBy: none
		sortByColumn: AnnéeMoisNum

		annotation SummarizationSetBy = Automatic

	column FinDeMois = EOMONTH( 'Dim_Date'[Date], 0 )
		dataType: dateTime
		formatString: dd/mm/yyyy
		lineageTag: b9f7888a-4ad5-4123-875c-b5088e380ff8
