		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Trimestre = "T" & QUARTER( 'Dim_Date'[Date] )
		dataType: string
		lineageTag: 4a95d294-b296-4fc7-a756-ff8dae65dfca
		summarizeBy: none
