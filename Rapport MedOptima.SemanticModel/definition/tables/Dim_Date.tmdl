	column NumMois = MONTH( 'Dim_Date'[Date] )
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 35b0234d-cf41-4a89-98a4-6a872b39ddb0
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Mois =
			VAR _Texte = FORMAT( 'Dim_Date'[Date], "mmmm" )
			RETURN
				UPPER( LEFT( _Texte, 1 ) ) & MID( _Texte, 2, LEN( _Texte ) )
		dataType: string
		lineageTag: 3b26c4f3-f52d-4b74-a48b-c497a685e24a
		summarizeBy: none
		sortByColumn: NumMois

		annotation SummarizationSetBy = Automatic

	column MoisCourt =
			VAR _Texte = FORMAT( 'Dim_Date'[Date], "mmm" )
			RETURN
				UPPER( LEFT( _Texte, 1 ) ) & MID( _Texte, 2, LEN( _Texte ) )
		dataType: string
		lineageTag: 39d79780-540e-43d4-bc9c-dff5bf3f75a7
		summarizeBy: none
		sortByColumn: NumMois

		annotation SummarizationSetBy = Automatic

	column AnnéeMoisNum = YEAR( 'Dim_Date'[Date] ) * 100 + MONTH( 'Dim_Date'[Date] )
		dataType: int64
