table Dim_Pharmacie
	lineageTag: 25a5be18-b80d-4729-956c-d9cfd4cad873

	column ID_Pharmacie
		dataType: string
		lineageTag: 2f4dae91-d28b-477d-8fe9-2c2cae91d8b2
		summarizeBy: none
		sourceColumn: ID_Pharmacie

		annotation SummarizationSetBy = Automatic

	column Pharmacie
		dataType: string
		lineageTag: 76a2358d-7c71-4212-9b41-7637449d9354
		summarizeBy: none
		sourceColumn: Pharmacie

		annotation SummarizationSetBy = Automatic

	column Ville
		dataType: string
		lineageTag: 3b5fc061-47e4-4931-a45c-f63df533ae20
		dataCategory: City
		summarizeBy: none
		sourceColumn: Ville

		annotation SummarizationSetBy = Automatic

	column Code_Postal
		dataType: int64
		formatString: 0
		lineageTag: 5c2a0685-c339-441f-ad0b-b593f74461b6
		summarizeBy: none
		sourceColumn: Code_Postal

		annotation SummarizationSetBy = Automatic

	column Type_Pharmacie
		dataType: string
		lineageTag: 0dbfa64d-ad1d-4fac-9773-41f971560a40
		summarizeBy: none
		sourceColumn: Type_Pharmacie

		annotation SummarizationSetBy = Automatic

	column Ville_Geo =
			VAR _Dept = LEFT( Dim_Pharmacie[Code_Postal], 2 )
			VAR _Nom =
				SWITCH(
					_Dept,
					"06", "Alpes-Maritimes",
					"08", "Ardennes",
					"10", "Aube",
					"13", "Bouches-du-Rhône",
					"24", "Dordogne",
					"30", "Gard",
					"31", "Haute-Garonne",
					"33", "Gironde",
					"34", "Hérault",
					"40", "Landes",
					"47", "Lot-et-Garonne",
					"51", "Marne",
					"54", "Meurthe-et-Moselle",
					"57", "Moselle",
					"59", "Nord",
					"64", "Pyrénées-Atlantiques",
					"65", "Hautes-Pyrénées",
					"66", "Pyrénées-Orientales",
					"67", "Bas-Rhin",
					"68", "Haut-Rhin",
					"75", "Paris",
					"77", "Seine-et-Marne",
					"78", "Yvelines",
					"80", "Somme",
					"82", "Tarn-et-Garonne",
					"83", "Var",
					"84", "Vaucluse",
					"91", "Essonne",
					"92", "Hauts-de-Seine",
					"93", "Seine-Saint-Denis",
					"94", "Val-de-Marne",
					"95", "Val-d'Oise",
					BLANK()
				)
			RETURN
				IF(
					ISBLANK( _Nom ),
					Dim_Pharmacie[Ville] & ", France",
					Dim_Pharmacie[Ville] & ", " & _Nom & ", France"
				)
		dataType: string
		isHidden
		lineageTag: bbfc5ee1-fb90-4879-b5e1-152db1a1e564
		dataCategory: Address
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition Dim_Pharmacie = m
		mode: import
		source =
				let
				  Source = fx_loadData("T_Dim_Pharmacie"),
				  #"Type de colonne changé" = Table.TransformColumnTypes(Source, {{"ID_Pharmacie", type text}, {"Pharmacie", type text}, {"Ville", type text}, {"Code_Postal", Int64.Type}, {"Type_Pharmacie", type text}})
				in
				  #"Type de colonne changé"

	annotation PBI_ResultType = Table

