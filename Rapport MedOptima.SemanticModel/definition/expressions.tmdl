expression CheminFichier = "D:\03 - Work\KAJY Partners\Conférence Excel BI\MedOptima\MedOptima_Distribution_Donnees.xlsx" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	lineageTag: 20a08c24-ecba-4dba-a4c8-1522d80f86cc

	annotation PBI_ResultType = Text

expression fx_loadData =
		let
		    Source = (itemName as text, optional isKindTable as logical) as table =>
		    [
		        Classeur = Excel.Workbook(
		            File.Contents(CheminFichier),
		            null,
		            true
		        ),
		        Kind = if isKindTable = null then "Table" else "Sheet",
		        Nav = Classeur{[Item = itemName, Kind = Kind]}[Data]
		    ][Nav]
		in
		    Source
	lineageTag: 478259e4-8c92-46ce-adc1-756bc2aed40d

	annotation PBI_ResultType = Function

